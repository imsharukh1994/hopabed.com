# BedHopper Cloud Database Configuration (.env)

# Option 1: Supabase (Recommended - Free Managed PostgreSQL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Option 2: Direct PostgreSQL Connection String (Neon / Render / AWS RDS)
DATABASE_URL=postgresql://postgres:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
